{
  "name": "lean",
  "module": "src/index.ts",
  "bin": {
    "lean": "src/index.ts"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "tui": "bun run src/extra/tui-main.ts",
    "test": "vitest run",
    "test:tui": "python3 scripts/verify-tui.py src/extra/tui-main.ts .lean/tui-checks",
    "typecheck": "bun check",
    "format": "bun fmt src package.json README.md .pre-commit-config.yaml",
    "format:check": "bun fmt --check src package.json README.md .pre-commit-config.yaml"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "26",
    "typescript": "^7.0.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "dependencies": {
    "@huggingface/jinja": "0.5.11",
    "@openai/agents": "^0.21.0",
    "@rezi-ui/core": "0.1.0-beta.2",
    "@rezi-ui/node": "0.1.0-beta.2",
    "shiki": "4.6.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  }
}
