{
  "name": "lean",
  "module": "src/index.ts",
  "bin": {
    "lean": "src/index.ts"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "vitest run",
    "test:terminal": "python3 scripts/verify-cli.py src/index.ts .lean/terminal-checks",
    "typecheck": "bun check",
    "format": "bun fmt src package.json README.md .pre-commit-config.yaml",
    "format:check": "bun fmt --check src package.json README.md .pre-commit-config.yaml"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "26",
    "typescript": "^7.0.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "dependencies": {
    "@openai/agents": "^0.21.0",
    "zod": "^4.6.7",
    "@earendil-works/pi-ai": "1.5.0"
  }
}
